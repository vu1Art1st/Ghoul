# Docker 部署配置（复制为 .env）
GHOUL_TAG=latest
# 兼容旧部署；新配置优先使用 GHOUL_TAG。
# ARTEX_TAG=latest
POSTGRES_USER=ghoul
POSTGRES_PASSWORD=change-me-please
POSTGRES_DB=ghoul

# LLM（二选一或都填；也可留空到 UI 里配）
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GHOUL_LLM_PROVIDER=
GHOUL_LLM_MODEL=
GHOUL_LLM_BASE_URL=
GHOUL_LLM_PROXY=
GHOUL_LLM_STREAM=
GHOUL_NOTIFY_ALLOW_LOCAL=
GHOUL_BTW_MAX_OUTPUT_TOKENS=

# Toshell C2（可选；api_key_ref 使用 env:TOSHELL_API_KEY 时填写）
TOSHELL_API_KEY=

# 旧变量仍兼容读取；迁移期可按需保留：
# ARTEX_LLM_PROVIDER=
# ARTEX_LLM_MODEL=
# ARTEX_LLM_BASE_URL=
# ARTEX_LLM_PROXY=
