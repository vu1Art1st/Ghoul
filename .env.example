# Docker 部署配置（复制为 .env）
GHOUL_IMAGE=ghoul
GHOUL_TAG=local
# 兼容旧部署；新配置优先使用 GHOUL_TAG。
# ARTEX_TAG=latest
POSTGRES_USER=ghoul
POSTGRES_PASSWORD=change-me-please
POSTGRES_DB=ghoul

# LLM（二选一或都填；也可留空到 UI 里配）
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GHOUL_LLM_PROVIDER=
GHOUL_LLM_MODEL=
GHOUL_LLM_BASE_URL=
GHOUL_LLM_PROXY=
GHOUL_LLM_STREAM=
GHOUL_NOTIFY_ALLOW_LOCAL=
GHOUL_BTW_MAX_OUTPUT_TOKENS=

# Host-network SOCKS5 bridge for Docker/WSL local loopback services.
# Use socks5://host.docker.internal:<port> in an LLM profile.
GHOUL_LOOPBACK_PROXY_PORT=11080
GHOUL_LOOPBACK_PROXY_ALLOW_SOURCES=127.0.0.1/32,172.16.0.0/12,::1/128
GHOUL_LOOPBACK_PROXY_ALLOW_TARGETS=127.0.0.0/8,::1/128

# Toshell C2（可选；api_key_ref 使用 env:TOSHELL_API_KEY 时填写）
TOSHELL_API_KEY=
TOSHELL_VERSION=v1.4.3
TOSHELL_COMMIT=
TOSHELL_RELEASE_BASE=https://github.com/iQingshan/Toshell/releases/download
TOSHELL_PUBLIC_HOST=127.0.0.1
TOSHELL_LISTENER_BIND=127.0.0.1
TOSHELL_LISTENER_PORT=8080
TOSHELL_PAYLOAD_BIND=127.0.0.1
TOSHELL_PAYLOAD_PORT=8081
GHOUL_C2_ALLOW_CONFIRM=false
GHOUL_C2_ALLOW_DANGER=false
GHOUL_C2_ALLOW_TUNNEL=false

# 旧变量仍兼容读取；迁移期可按需保留：
# ARTEX_LLM_PROVIDER=
# ARTEX_LLM_MODEL=
# ARTEX_LLM_BASE_URL=
# ARTEX_LLM_PROXY=
